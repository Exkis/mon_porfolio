# Neon PostgreSQL connection string. Keep the real value in .env.local and Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_PASSWORD="set-only-for-the-seed-command"
